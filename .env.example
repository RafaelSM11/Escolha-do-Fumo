# Copie este arquivo para ".env" e preencha com os dados do seu projeto LiveKit Cloud
# (crie uma conta gratuita em https://cloud.livekit.io)

LIVEKIT_API_KEY=coloque_sua_api_key_aqui
LIVEKIT_API_SECRET=coloque_seu_api_secret_aqui
LIVEKIT_URL=wss://seu-projeto.livekit.cloud

# Porta em que o servidor local vai rodar (opcional)
PORT=3000

# Senha simples para proteger quem pode iniciar uma transmissao (opcional, mas recomendado)
HOST_PASSWORD=troque-esta-senha

PORT=3000

# LiveKit Cloud (crie uma conta gratuita em https://cloud.livekit.io)
LIVEKIT_URL=wss://seu-projeto.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Senha que só você conhece, usada para entrar como admin na aba Transmissão
ADMIN_PASSWORD=

# Nome fixo da sala de transmissão (opcional, pode deixar o padrão)
LIVE_ROOM_NAME=escolha-do-fumo-live
